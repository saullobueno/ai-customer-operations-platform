# Copie para .env.local e preencha os valores. Nunca commite .env.local.

# Postgres (docker-compose por padrão)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_customer_operations"

# Redis (docker-compose por padrão)
REDIS_URL="redis://localhost:6379"

# Better Auth
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# IA (Vercel AI SDK via GroqCloud — https://console.groq.com)
GROQ_API_KEY=""
AI_MODEL_ID="openai/gpt-oss-120b"

# Alternativas suportadas pelo SDK, não usadas pelo client atual (src/server/ai/client.ts)
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Stripe (modo teste) — sem essas 3, /billing fica em modo mock (ver ADR 0011)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_PRO=""

# Resend — sem essa chave, e-mails só são logados no console (modo mock)
RESEND_API_KEY=""
