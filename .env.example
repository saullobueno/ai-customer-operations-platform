# Copie para .env.local e preencha os valores. Nunca commite .env.local.

# Postgres (docker-compose por padrão)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_customer_operations"

# Redis (docker-compose por padrão)
REDIS_URL="redis://localhost:6379"

# Better Auth
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# IA (Vercel AI SDK) — opcional; features de IA ficam mockadas sem essas chaves
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Stripe (modo teste)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Resend
RESEND_API_KEY=""
